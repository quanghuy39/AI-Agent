# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=
R2_INPUT_PREFIX=input/
R2_OUTPUT_PREFIX=output/

# Token READ ONLY (doc du lieu nguon)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Token READ & WRITE (ghi ket qua vao output/)
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=

# Cau hinh agent
DEFAULT_ENGINE=python
CAUTION_LEVEL=chuan

# Khoa API cua 4 hang LLM (de trong, dien o Ngay 2)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Duong dan cau hinh model
LLM_CONFIG_PATH=config/llm.yaml